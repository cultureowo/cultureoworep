{
  "name": "test4",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:unit": "jest test/service.unit.test.js --runInBand --modulePathIgnorePatterns=\"<rootDir>/(performance/results|dist)\"",
    "test:integration": "jest test/repositories.test.js test/service.integration.test.js test/api.integration.test.js --runInBand --modulePathIgnorePatterns=\"<rootDir>/(performance/results|dist)\"",
    "test:ci": "npm run test:unit && npm run test:integration",
    "start:lab7": "node --env-file=.env.lab7 src/api.js",
    "db:lab7": "docker compose -f compose.lab7.yaml up -d --wait",
    "perf:baseline": "node performance/run-k6.cjs baseline",
    "perf:load": "node performance/run-k6.cjs load",
    "perf:stress": "node performance/run-k6.cjs stress",
    "perf:jmeter:baseline": "node performance/run-jmeter.cjs baseline",
    "perf:jmeter:load": "node performance/run-jmeter.cjs load",
    "perf:jmeter:stress": "node performance/run-jmeter.cjs stress",
    "perf:compare": "node performance/compare.cjs",
    "test": "jest",
    "test:lab5": "jest test/container-environment.test.js test/wiremock-environment.test.js test/shipping.containers.integration.test.js --runInBand",
    "test:lab6": "jest test/api.integration.test.js --runInBand",
    "build": "node scripts/build.cjs",
    "db:migrate": "node scripts/migrate.cjs"
  },
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0"
  }
}
